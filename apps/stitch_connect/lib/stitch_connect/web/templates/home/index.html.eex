<div class="landing-hero">
  <div class="container">
    <div class="header">
      <a href="/" class="brand">
        <img src="<%= static_path(@conn, "/images/stitch-brand.png") %>" alt="Stitch">
      </a>

      <div class="nav-items">
        <ul class="list-inline text-right m-b-0">
          <li><a href="/signin">Sign In</a></li>
          <li><a href="/signup/email" class="btn-outline">Create Team</a></li>
        </ul>
      </div>
    </div>


    <div class="landing-message text-center">
      <h1>Care Coordination</h1>
      <h3>Communicate, write notes, track tasks, <br/>upload files, and collaborate on any device.</h3>

      <form class="flex-form">
        <div class="form-input">
          <input type="email" class="form-control" id="createTeam" placeholder="Email Address">
        </div>

        <button type="submit" class="btn btn-default">Create Team</button>
      </form>

      <div class="trial">Get started with an unlimited <br class="visible-xs-inline" />number of people on our free 14-day trial.</div>
    </div>
  </div>
</div>

<div class="our-customers text-center">
  <div class="container">
    <h3>Thousands of healthcare providers are improving patient care through Stitch. <br/><strong>Join the movement.</strong></h3>

    <div class="customer-logos">
      <div class="row logo-row">
        <div class="col-lg-5ths col-md-3 col-xs-4">
          <img src="<%= static_path(@conn, "/images/customer-opternative.png") %>" alt="Clarity">
        </div>
        <div class="col-lg-5ths col-md-3 col-xs-4">
          <img src="<%= static_path(@conn, "/images/customer-clarity.png") %>" alt="Clarity">
        </div>
        <div class="col-lg-5ths col-md-3 col-xs-4">
          <img src="<%= static_path(@conn, "/images/customer-triggr.png") %>" alt="Clarity">
        </div>
        <div class="col-lg-5ths col-md-3 col-xs-4">
          <img src="<%= static_path(@conn, "/images/customer-whitecross.png") %>" alt="Clarity">
        </div>
        <div class="col-lg-5ths col-md-3 col-xs-4 visible-lg">
          <img src="<%= static_path(@conn, "/images/customer-dssi.png") %>" alt="Clarity">
        </div>

        <div class="col-lg-5ths col-md-3 col-xs-4">
          <img src="<%= static_path(@conn, "/images/customer-rma.png") %>" alt="Clarity">
        </div>
        <div class="col-lg-5ths col-md-3 col-xs-4">
          <img src="<%= static_path(@conn, "/images/customer-coastal.png") %>" alt="Clarity">
        </div>
        <div class="col-lg-5ths col-md-3 col-xs-4">
          <img src="<%= static_path(@conn, "/images/customer-luminance.png") %>" alt="Clarity">
        </div>
        <div class="col-lg-5ths col-md-3 col-xs-4">
          <img src="<%= static_path(@conn, "/images/customer-firstcall.png") %>" alt="Clarity">
        </div>
        <div class="col-lg-5ths col-md-3 col-xs-4 visible-lg">
          <img src="<%= static_path(@conn, "/images/customer-mihaw.png") %>" alt="Clarity">
        </div>

        <div class="col-lg-5ths col-md-3 col-xs-4">
          <img src="<%= static_path(@conn, "/images/customer-vosrx.png") %>" alt="Clarity">
        </div>
        <div class="col-lg-5ths col-md-3 col-xs-4">
          <img src="<%= static_path(@conn, "/images/customer-pchhh.png") %>" alt="Clarity">
        </div>
        <div class="col-lg-5ths col-md-3 col-xs-4">
          <img src="<%= static_path(@conn, "/images/customer-gpeyecare.png") %>" alt="Clarity">
        </div>
        <div class="col-lg-5ths col-md-3 col-xs-4">
          <img src="<%= static_path(@conn, "/images/customer-globonics.png") %>" alt="Clarity">
        </div>
        <div class="col-lg-5ths col-md-3 col-xs-4 visible-lg">
          <img src="<%= static_path(@conn, "/images/customer-wdg.png") %>" alt="Clarity">
        </div>
      </div>
    </div>
  </div>
</div>