<h1>Teams</h1>
<table>
  <tr>
    <th>Name</th>
    <th>Slug</th>
    <th>Total Users</th>
    <th>Enabled Users</th>
    <th>Disabled Users</th>
    <th></th>
  </tr>
  <%= for team <- @teams do %>
    <tr>
      <td><%= team.name %></td>
      <td><%= team.slug %></td>
      <td><%= team.total_users %></td>
      <td><%= team.enabled_users %></td>
      <td><%= team.disabled_users %></td>
      <td></td>
    </tr>
  <% end %>
</table>

<%= render StitchConnect.Web.Admin.AppView, "_page_links.html", @meta %>
