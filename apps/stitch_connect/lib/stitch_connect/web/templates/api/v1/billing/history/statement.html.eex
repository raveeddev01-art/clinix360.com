<html cmd="wkhtmltopdf -d 470 statement-pdf.html test.pdf">

  <head>
    <style>
      body {
        font-family: Arial, Helvetica, sans-serif;
      }

      a {
        text-decoration: none;
        color: #026aa7;
      }

      .wrapper {
        width: 470px;
        min-width: 470px;
        max-width: 470px;
        margin: 0 auto;
        background: white;
        padding: 40px;
      }

      .header {
        padding: 20px 0;
        border-bottom: solid 2px #DDDDDD;
      }

      .header .logo {
        background: #036;
      }

      .container {
        margin: 20px 0;
      }

      .table {
        background: #EEEEEE;
        border: solid 2px #CCCCCC;
        padding: 20px 0;
        margin: 40px 0;
      }


      table,
      tr,
      td {
        border: none;
        background: none;
        padding: 0;
        margin: 0;
      }

      table {
        margin: auto 0;
      }

      td {
        padding: 15px 60px;
      }

      .footer {
        font-size: 14px;
        margin-top: 70px;
        text-align: center;
      }

      .footer hr {
        width: 60%;
        margin: 30px auto;
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="header">
        <img src="https://teamstitch.com/images/stitch-brand.png" class="logo" />
      </div>
      <div class="container">
        <b><%= @today %></b>
        <p>
          Thanks for using Stitch! We hope you enjoyed your experience with us this month. Below, please find a summary of charges
          for
          <b><%= @team_name %></b>
        </p>

        <div class="table">
          <table>
            <tr>
              <td>Subscription:</td>
              <td><%= @subscription %></td>
            </tr>
            <tr>
              <td>Active Users:</td>
              <td><%= @quantity %></td>
            </tr>
            <tr>
              <td>Credits Applied:</td>
              <td>$0</td>
            </tr>
            <tr>
              <td>Total Charge:</td>
              <td>$<%= @amount %></td>
            </tr>
            <tr>
              <td>Payment Card:</td>
              <td><%= @card_brand %> <%= @card_last4 %></td>
            </tr>
          </table>
        </div>
      </div>

      <div class="footer">
        <p>Questions about your billing statement?
          <br/> Email us at
          <a href="mailto:support@teamstitch.com">support@teamstitch.com</a>
          or give us a call at
          <a href="#">+1 (650) 282-3388</a>.
        </p>
        <hr/>
        <p>
          Stitch Technologies, Inc.
          <br/> 188 King St. PH9, San Francisco, CA 94107
        </p>
      </div>
    </div>
  </body>

</html>
