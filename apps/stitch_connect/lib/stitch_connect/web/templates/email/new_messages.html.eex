<tr>
  <td class="content-block">
    <div class="messages-content">
      <h2>Hi <%= @first_name %>,</h2>
    <div>
  </td>
</tr>
<tr>
  <td class="content-block">
    <p>
      You have<%=@count_string%>from <b><%=@team_name%></b> (<b><a href="<%=@team_url%>"><%=@team_url%></a></b>).
    </p>
    <hr>
  </td>
</tr>
<tr>
  <td class="content-block">
    <div class="messages-container">
      <%= for group <- @groups do %>
        <h4 class="group-name">
          <%= group.group_name %>
        </h4>
        <%= for message <- group.messages do %>
          <div class="message-container">
            <a href="#">
              <img src="<%= StitchConnect.Web.Api.V1.UserView.avatar_thumb(message.user) %>"
                  class="user-avatar">
              </img>
            </a>
            <div>
              <a href="<%= message.group_url %>" class="username"><%= message.user.first_name %> <%= message.user.last_name %></a>
              <span class="time"><%= message.inserted_at %></span>
              <br />
              <%= message.text_content %>
            </div>
          </div>
        <% end %>
        <hr>
      <% end %>
    </div>
  </td>
</tr>
<tr>
  <td class="content-block">
    <p>
      <br />
      <a href="<%= @notification_settings_url %>">Turn these email notifications off on your account page.</a>
    </p>
  </td>
</tr>
