<tr>
  <td class="content-block">
    <div class="messages-content">
      <h2>Hi <%= @first_name %>,</h2>
    <div>
  </td>
</tr>
<tr>
  <td class="content-block">
    <p>
      You have <%= @new_message_count %> new <%= @inflected_message %> waiting for you.
    </p>
  </td>
</tr>
<tr>
  <td style="text-align: center;" class="content-block" itemprop="handler" itemscope itemtype="http://schema.org/HttpActionHandler">
    <a href="<%= @login_url %>" class="btn-primary" itemprop="url">
      Sign-in to Stitch Connect
    </a>
  </td>
</tr>
<tr>
  <td class="content-block" style="text-align: center">
    <p>
      <strong>Your sign-in email is:</strong> <%= @receiver_email %>
    </p>
  </td>
</tr>
<tr>
  <td class="content-block">
    <div class="messages-container">
      <%= for group <- @groups do %>
        <h4 class="group-name">
          <%= group.group_name %>
        </h4>
        <%= for message <- group.messages do %>
          <div class="message-container">
            <a href="#">
              <img src="<%= StitchConnect.Web.Api.V1.UserView.avatar_thumb(message.user) %>"
                  class="user-avatar">
              </img>
            </a>
            <div>
              <a href="<%= message.group_url %>" class="username"><%= message.user.first_name %> <%= message.user.last_name %></a>
              <span time="time"><%= message.inserted_at %></span>
              <br />
              <%= message.text_content %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </td>
</tr>
<tr>
  <td class="content-block">
    <p>
      If you need anything, we can help. Reply to this email or send a new one to us by clicking <a href="mailto:support@teamstitch.com" target="_blank">here</a>. We're online 7 days a week and love to hear from you :)
    </p>
    <p>
      See you inside!<br />
      -- Team Stitch
    </p>
    <p>
      <br />
      <a href="<%= @notification_settings_url %>">Turn these email notifications off on your account page.</a>
    </p>
  </td>
</tr>
