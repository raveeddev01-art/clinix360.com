<div id="app">

  <div id="side">
    <div class="flex-header">
      <h4 class="text-capitalize"><%= @subdomain %></h4>

      <i class="fa fa-chevron-down"></i>
    </div>

    <div class="flex-footer">
      <div class="user">
        <div class="name">Daniel Tapia</div>
        <div class="status">online</div>
      </div>

      <div class="user-actions">
        <a href="#" class="btn"><i class="fa fa-bell"></i></a>
      </div>
    </div>

    <div class="flex-content">
      <div class="menu-nav m-b-20">
        <h5 class="heading" style="margin-top: 20px;">Favorites</h5>
        <a href="#" class="item">
          <div class="item-icon"><i class="fa fa-hashtag"></i></div>
          <div class="item-text">patients</div>
          <div class="item-badge text-center">3</div>
        </a>
      </div>

      <div class="menu-nav group m-b-20">
        <h5 class="heading">Groups</h5>
        <a href="#" class="item active">
          <div class="item-icon"><i class="fa fa-hashtag"></i></div>
          <div class="item-text">general</div>
        </a>

        <a href="#" class="item">
          <div class="item-icon"><i class="fa fa-hashtag"></i></div>
          <div class="item-text">patients</div>
          <div class="item-badge text-center">3</div>
        </a>

        <a href="#" class="item">
          <div class="item-icon"><i class="fa fa-hashtag"></i></div>
          <div class="item-text">labs</div>
        </a>

        <a href="#" class="item">
          <div class="item-icon"><i class="fa fa-hashtag"></i></div>
          <div class="item-text">prescriptions</div>
        </a>
      </div>

      <div class="menu-nav people m-b-20">
        <h5 class="heading">People</h5>
        <a href="#" class="item" style="font-style: normal; color: #333;">
          <div class="item-icon" style="color:#13CE66;"><i class="fa fa-circle"></i></div>
          <div class="item-text">Daniel Tapia</div>
        </a>

        <a href="#" class="item">
          <div class="item-icon"><i class="fa fa-circle-o"></i></div>
          <div class="item-text">Jack Roush</div>
        </a>

        <a href="#" class="item">
          <div class="item-icon"><i class="fa fa-circle-o"></i></div>
          <div class="item-text">Emily Hope</div>
        </a>

        <a href="#" class="item">
          <div class="item-icon"><i class="fa fa-circle-o"></i></div>
          <div class="item-text">Tom Davis</div>
        </a>

        <a href="#" class="item">
          <div class="item-icon"><i class="fa fa-circle-o"></i></div>
          <div class="item-text">Mark Green</div>
        </a>
      </div>
    </div>
  </div>


  <div id="main">
    <div class="flex-header">
      <div class="header-content">
        <h4>#general</h4>
      </div>

      <div class="header-nav">
        <a href="#" class="btn btn-default"><i class="fa fa-user"></i></a>
        <a href="#" class="btn btn-default"><i class="fa fa-search"></i></a>
        <a href="#addons-toggle" class="btn btn-default" id="addons-toggle"><i class="fa fa-ellipsis-v"></i></a>
      </div>
    </div>

    <div class="flex-content">

      <div id="chat-container">
        <div id="chat" data-component="Chat"></div>

        <div class="flex-footer">
          <input type="text" class="form-control" placeholder="Write something">
        </div>
      </div>

      <div id="addons">
        <div class="flex-header">
          <h4>Directory</h4>
        </div>

        <div class="flex-content">
          <div class="addon-directory">
            <div class="subheading">
              <div class="flex-item">
                1 <span class="text-muted">/1</span> Member
              </div>
              <a href="#" class="btn btn-sm btn-default">Show only online</a>
            </div>
            <hr>
            <ul class="list-unstyled">
              <li><i class="fa fa-circle"></i> <strong>Daniel Tapia</strong> <span class="text-muted">daniel</span></li>
              <li><i class="fa fa-circle-o"></i> <strong>Emily Hope</strong> <span class="text-muted">emhope</span></li>
              <li><i class="fa fa-circle-o"></i> <strong>Jack Roush</strong> <span class="text-muted">roush</span></li>
              <li><i class="fa fa-circle-o"></i> <strong>Tom Davis</strong> <span class="text-muted">tomdavis</span></li>
              <li><i class="fa fa-circle-o"></i> <strong>Mark Green</strong> <span class="text-muted">mgreen</span></li>
            </ul>

            <hr>

            <div class="profile-details">
              <h4 class="text-center">Daniel Tapia</h4>
              <hr>
              <div class="item">
                <div class="item-label text-muted">Username</div>
                <div class="item-value">@daniel</div>
              </div>

              <div class="item">
                <div class="item-label text-muted">Time Zone</div>
                <div class="item-value">3:25 PM (UTC -4)</div>
              </div>

              <div class="item">
                <div class="item-label text-muted">Email Address</div>
                <div class="item-value">betamail20@mailinator.com</div>
              </div>

              <div class="item">
                <div class="item-label text-muted">Phone Number</div>
                <div class="item-value">123456789</div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

</div>