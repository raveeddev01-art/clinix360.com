<div id="app">

  <div id="menu">
    <div class="header">
      <h4 class="text-capitalize"><%= @subdomain %></h4>
      <div class="username">danieltapia</div>
    </div>

    <div class="flex-content">
      <div class="heading">
        <h5>Groups</h5>
      </div>
      <ul class="list-unstyled groups">
        <li><a href="#" class="active">general</a></li>
        <li><a href="#">labs</a></li>
        <li><a href="#">patients</a></li>
        <li><a href="#">random</a></li>
      </ul>

      <div class="heading">
        <h5>People</h5>
      </div>
      <ul class="list-unstyled people">
        <li><a href="#">Daniel Tapia</a></li>
        <li><a href="#">John Appleseed</a></li>
        <li><a href="#">Sally Bond</a></li>
        <li><a href="#">Jason Bourne</a></li>
      </ul>
    </div>
  </div>

  <div id="main-container">
    <div class="header">
      <div class="visible-xs-inline-block visible-sm-inline-block">
        <a href="#menu-toggle" class="btn btn-default" id="menu-toggle"><i class="fa fa-bars"></i></a>
      </div>

      <div class="title">
        <h4>General</h4>
      </div>
      <a href="#addons-toggle" class="btn btn-default pull-right" id="addons-toggle"><i class="fa fa-home"></i></a>
    </div>

    <div id="main">
      <div id="chat">
        <div id="conversation" class="flex-content">

          <div class="message">
