<div id="wrapper" class="smooth-transition">

  <div id="sidemenu" class="smooth-transition">
    <a class="header m-b-20">
      <h4 class="team text-capitalize"><%= @subdomain %></h4>
      <div class="username">danieltapia</div>
    </a>

    <div class="menu-heading">
      <a href="#" class="heading text-uppercase">Groups</a>
      <a href="#" class="icon pull-right"><i class="fa fa-plus"></i></a>
    </div>
    <ul class="list-unstyled groups">
      <li><a href="#" class="active">home</a></li>
      <li><a href="#">general</a></li>
      <li><a href="#">labs</a></li>
    </ul>

    <div class="menu-heading">
      <a href="#" class="heading text-uppercase">People</a>
      <a href="#" class="icon pull-right"><i class="fa fa-plus"></i></a>
    </div>
    <ul class="list-unstyled people">
      <li><a href="#">Daniel Tapia</a></li>
      <li><a href="#">John Appleseed</a></li>
      <li><a href="#">Mark Fix</a></li>
      <li><a href="#">Sally Fix</a></li>
      <li><a href="#">Cindy Masin</a></li>
      <li><a href="#">Jason Bourne</a></li>
    </ul>
  </div>


  <div id="addons" class="smooth-transition">
    <div class="addon-heading">
      <h4>Team Directory</h4>
    </div>
  </div>


  <div id="main-wrapper">
    <div class="header">
      <div class="chat-header">
        <div class="visible-xs-inline-block visible-sm-inline-block">
          <a href="#menu-toggle" class="btn btn-default" id="menu-toggle"><i class="fa fa-bars"></i></a>
        </div>

        <div class="title">
          <h4>#general</h4>
        </div>
      </div>

      <div class="addons-header">
        <ul class="list-inline m-b-0">
          <li><a href="#" class="hidden-xs hidden-sm"><i class="fa fa-cog"></i></a></li>
          <li><a href="#" class="hidden-xs hidden-sm"><i class="fa fa-info-circle"></i></a></li>
          <li><a href="#"><i class="fa fa-search"></i></a></li>
          <li><a href="#addons-toggle" id="addons-toggle"><i class="fa fa-ellipsis-h"></i></a></li>
        </ul>
      </div>
    </div>

    <div class="chat-container smooth-transition">
      <div class="container-fluid">
        <div class="row">
          <div class="col-lg-12">
            <h1 style="background: salmon;">Stitch Main Chat</h1>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>