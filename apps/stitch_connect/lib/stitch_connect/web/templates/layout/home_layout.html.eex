    <%= render @view_module, @view_template, assigns %>

    <!-- <p class="alert alert-info" role="alert"><%= get_flash(@conn, :info) %></p>
    <p class="alert alert-danger" role="alert"><%= get_flash(@conn, :error) %></p>

    <main role="main">
      <%= render @view_module, @view_template, assigns %>
    </main> -->

    <%= render "_js_variables.html", conn: @conn %>
    <script src="<%= static_path(@conn, "/js/landing_app.js") %>"></script>
    <%= render "_intercom_website.html", conn: @conn %>
    <%= render "_segment.html", conn: @conn %>
