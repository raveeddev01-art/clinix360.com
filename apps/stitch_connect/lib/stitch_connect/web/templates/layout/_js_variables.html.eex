<%
applicationHost =
  case Application.get_env(:stitch_connect, :env) do
    :dev ->
      "localhost:4000"
    :prod ->
      "sb969e158.fastvps-server.com:4443"
    _ ->
      "localhost:4000"
  end
authenticationToken = Plug.Conn.get_session(@conn, :authentication_token)
user = Plug.Conn.get_session(@conn, :current_user)
current_user =
  case user do
    nil ->
      Poison.encode!(%{})
    user ->
      Poison.encode!(%{
        "id" => user.id,
        "firstName" => user.first_name,
        "lastName" => user.last_name,
        "roles" => user.roles,
        "favoriteGroups" => user.favorite_groups
      })
  end
%>

<script>
  window.applicationHost = "<%= applicationHost %>";
  window.authenticationToken = "<%= authenticationToken %>";
  window.currentUser = <%= raw current_user %>;
</script>