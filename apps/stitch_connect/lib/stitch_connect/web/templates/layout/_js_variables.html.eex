<%
applicationHost = Application.fetch_env!(:stitch_connect, :application_host)
applicationScheme = Application.fetch_env!(:stitch_connect, :application_scheme)
websocketScheme = Application.fetch_env!(:stitch_connect, :websocket_scheme)
authenticationToken = Plug.Conn.get_session(@conn, :current_user_token)
session_id = Plug.Conn.get_session(@conn, :session_id)
locked = !!Plug.Conn.get_session(@conn, :locked)
user = Map.get(@conn.assigns, :current_user)
intercom_user_hash = Plug.Conn.get_session(@conn, :intercom_user_hash)
public_bucket_name = System.get_env("S3_PUBLIC_BUCKET_NAME")
current_user =
  case user do
    nil ->
      Poison.encode!(%{})
    user ->
      Poison.encode!(%{
        "id" => user.id,
        "whatsNewLastSeenAt" => user.whats_new_last_seen_at,
        "firstName" => user.first_name,
        "lastName" => user.last_name,
        "roles" => user.roles,
        "username" => user.username,
        "email" => user.email,
        "title" => user.title,
        "phone" => user.phone_number,
        "avatar" => StitchConnect.PresignedUrlCache.fetch(user.profile_image_url),
        "avatar_thumb" => StitchConnect.PresignedUrlCache.fetch(user.profile_image_thumb_url),
        "team" => %{
          "securityLockoutEnabled" => user.team.security_lockout,
          "secondsToLockout" => user.team.seconds_to_lockout,
          "openInvitationsEnabled" => user.team.open_invitations_enabled,
          "name" => user.team.name,
          "slug" => user.team.slug,
          "hipaaEnabled" => user.team.hipaa_enabled,
          "id" => user.team.id
        }
      })
  end
%>

<script>
  window.applicationHost = "<%= applicationHost %>";
  window.applicationScheme = "<%= applicationScheme %>";
  window.websocketScheme = "<%= websocketScheme %>";
  window.locked = <%= locked %>;
  window.authenticationToken = "<%= authenticationToken %>";
  window.sessionId = "<%= session_id %>";
  window.currentUser = <%= raw current_user %>;
  window.applicationVersion = "<%= StitchConnect.version() %>";
  window.stripePublishableKey = "<%= Application.get_env(:stitch, :stripe_publishable_key) %>";
  window.intercomUserHash = "<%= intercom_user_hash %>";
  window.dr_chrono_client_id = "<%= System.get_env("DRCHRONO_CLIENT_ID") %>";
  window.publicBucket = "https://s3.amazonaws.com/<%=public_bucket_name%>";
</script>
