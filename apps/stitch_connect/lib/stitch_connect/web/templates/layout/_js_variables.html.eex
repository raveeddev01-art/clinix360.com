<%
applicationHost = if (Mix.env == :dev), do: "localhost:4443", else: "teamstitchapp.com"
authenticationToken = Plug.Conn.get_session(@conn, :authentication_token)
user = Plug.Conn.get_session(@conn, :current_user)
current_user =
  case user do
    nil ->
      Poison.encode!(%{})
    user ->
      Poison.encode!(%{
        "id" => user.id,
        "fullname" => user.fullname
      })
  end
%>

<script>
  window.applicationHost = "<%= applicationHost %>";
  window.authenticationToken = "<%= authenticationToken %>";
  window.currentUser = <%= raw current_user %>;
</script>