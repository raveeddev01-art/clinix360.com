{
  "parser": "babel-eslint",
  "env": {
    "browser": true,
    "commonjs": true,
    "es6": true,
    "node": true
  },
  "extends": ["airbnb", "prettier", "prettier/react"],
  "plugins": ["import", "jsx-a11y", "prettier", "react"],
  "parserOptions": {
    "ecmaFeatures": {
      "experimentalObjectRestSpread": true,
      "experimentalDecorators": true,
      "jsx": true
    },
    "sourceType": "module"
  },
  "rules": {
    "constructor-super": "warn",
    "class-methods-use-this": "off",
    "no-const-assign": "warn",
    "no-this-before-super": "warn",
    "no-undef": "warn",
    "no-unreachable": "warn",
    "no-unused-vars": "warn",
    "react/prop-types": [
      "error",
      {
        "ignore": [
          "addonStore",
          "groupStore",
          "messageStore",
          "presenceStore",
          "sidemenuStore"
        ]
      }
    ],
    "valid-typeof": "warn"
  },
  "globals": {
    "currentUser": false
  }
}
