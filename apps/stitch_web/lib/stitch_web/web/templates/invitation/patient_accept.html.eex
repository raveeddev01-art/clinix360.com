<%# This is temporarily added for internal testing. Will be replaced soon. %>

<div style="padding: 30px;  width: 100%; text-align: center;">
  <%= form_for @conn, "/patient/invitations/accept/#{@token}", [as: :patient], fn f -> %>
  
    <%= text_input f, :first_name, placeholder: "first_name", value: @first_name%>
    <br /> <br />

    <%= text_input f, :last_name, placeholder: "last_name", value: @last_name %>
    <br /> <br />
    
    <%= number_input f, :phone_number, placeholder: "phone_number", value: @phone_number %>
    <br /> <br />
    
    <%= password_input f, :password, placeholder: "password" %>
    <br /> <br />
    
    <%= submit "Enter Carespace" %>

  <% end %>
</div>
