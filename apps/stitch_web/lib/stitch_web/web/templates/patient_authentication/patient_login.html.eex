<%# This is temporarily added for internal testing. Will be replaced soon. %>

<div style="padding: 30px;  width: 100%; text-align: center;">
  <%= form_for @conn, "/patient/login", [as: :patient], fn f -> %>
    <%= text_input f, :email, placeholder: "email" %>
    <br /> <br />
    <%= password_input f, :password, placeholder: "password" %>
    <br /> <br />
    <%= submit "Enter Carespace" %>
  <% end %>
</div>
