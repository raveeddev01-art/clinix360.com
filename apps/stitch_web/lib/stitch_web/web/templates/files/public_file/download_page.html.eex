<%= if assigns[:app_params] do %>
  <div class="main">
    <a class="download" href="<%= @app_params.url %>">
      <div class="download-icon">
        <i class="<%= @app_params.icon %> icon-main"></i>
        <i class="fa fa-arrow-circle-down icon-down"></i>
      </div>
      <div class="download-content">
        <div class="filename">
          <%= @app_params.file.filename %>
        </div>
        <div class="download-content-bottom">
          <span class="filesize">
            <%= @app_params.file.size_in_bytes %>
          </span>
          <span class="file-content">
            <span class="filetype">
              <%= @app_params.file.filetype %>
            </span>
            <span class="download-text">
              - Click to download
            </span>
          </span>
        </div>
      </div>
    </a>
  </div>
  <div class="footer">
    <div class="footer-left">
      <span class="filename">
        <%= @app_params.file.filename %>
      </span>
      <span class="filesize">
        <%= @app_params.file.size_in_bytes %>
      </span>
      <span class="filetype">
        <%= @app_params.file.filetype %>
      </span>
    </div>
    <div class="footer-right">
      <span>Public file shared from</span>
      <a href="https://dvlcloud.com">
        <img src="https://dvlcloud.com/images/invochat logo.png" class="logo" />
      </a>
    </div>
  </div>
<% end %>

<script type="text/javascript">
function getFileSize(size) {
  if (size < 1024) {
    return size + 'bytes';
  } else if (size < 1024 * 1024) {
    return (size / 1024).toFixed(1) + 'KB';
  } else if (size < 1024 * 1024 * 1024) {
    return (size / 1024 / 1024).toFixed(1) + 'MB';
  }
  return (size / 1024 / 1024 / 1024).toFixed(1) + 'GB';
}

var filesizes = document.getElementsByClassName('filesize');
for (var i = 0; i < filesizes.length; i += 1) {
  var el = filesizes[i];
  var text = el.innerHTML || '';
  var size = parseInt(text.trim(), 10);
  el.innerHTML = getFileSize(size);
}
</script>
