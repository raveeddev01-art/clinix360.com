<%
locked = false
patient = Map.get(@conn.assigns, :patient)
authenticationToken = patient && patient.token
patient =
  case patient do
    nil ->
      Poison.encode!(%{})
    patient ->
      Poison.encode!(%{
        "id" => patient.id,
        "first_name" => patient.first_name,
        "last_name" => patient.last_name,
        "email" => patient.email,
        "phone" => patient.phone_number,
        "avatar" => patient.profile_image_url,
        "avatar_thumb" => patient.profile_image_thumb_url,
        "team" => %{
          "securityLockoutEnabled" => patient.team.security_lockout,
          "secondsToLockout" => patient.team.seconds_to_lockout,
          "openInvitationsEnabled" => patient.team.open_invitations_enabled,
          "name" => patient.team.name,
          "slug" => patient.team.slug,
          "concealEnabled" => patient.team.conceal_enabled,
          "id" => patient.team.id
        }
      })
  end
%>

<script>
  window.locked = <%= locked %>;
  window.authenticationToken = "<%= authenticationToken %>";
  window.currentPatient = <%= raw patient %>;
  window.currentUser = window.currentPatient
  window.socketPath = "patient_socket"
</script>
