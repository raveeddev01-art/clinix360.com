<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MMLMP6C');</script>
    <!-- End Google Tag Manager -->

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://dvlcloud.com" rel="canonical">
    <meta name="author" content="">
    <meta name="csrf-token" content="<%= Plug.CSRFProtection.get_csrf_token %>">

    <title><%= if assigns[:title], do: @title, else: "Care Coordination | InvoCom" %></title>
    <link rel="shortcut icon" type="image/png" href="/favicon.ico">
    <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700,900" rel="stylesheet">
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <!--[if lt IE 9]>
    <script>
      (function(){
        var ef = function(){};
        window.console = window.console || {log:ef,warn:ef,error:ef,dir:ef};
      }());
    </script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/html5shiv/3.7.2/html5shiv.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/html5shiv/3.7.2/html5shiv-printshiv.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/es5-shim/3.4.0/es5-shim.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/es5-shim/3.4.0/es5-sham.js"></script>
    <![endif]-->
    <style>
      html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-width: 100%;
        height: 100%;
        min-height: 100%;
        font-family: "Source Sans Pro";
        font-size: 16px;
        color: #333;
      }

      * {
        box-sizing: border-box;
      }

      a {
        text-decoration: none;
        color: #036;
      }

      a:hover, a:active, a:visited {
        color: #036;
      }

      .content {
        width: 100%;
        min-width: 100%;
        height: 100%;
        min-height: 100%;
        display: flex;
        flex-direction: column;
      }

      .main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f1f1f1;
      }

      .download {
        display: flex;
        border-radius: 5px;
        max-width: 600px;
        min-width: 400px;
        margin: 0 auto;
        background: #fff;
        padding: 20px;
      }

      .download-text {
        position: absolute;
        background: #fff;
        font-size: 14px;
        color: #999;
        overflow-y: hidden;
        display: inline-block;
        width: 120px;
        top: 2px;
        display: none;
        /* transition: all .3s cubic-bezier(0, 1, 0.5, 1); */
      }

      .download-icon {
        position: relative;
        font-size: 32px;
        margin-right: 20px;
      }

      .fa.icon-down {
        font-size: 14px;
        position: absolute;
        right: -5px;
        bottom: 0;
        background: #fff;
        border-radius: 100%;
        max-height: 0;
        overflow-y: hidden;
        /* transition: all .3s cubic-bezier(0, 1, 0.5, 1); */
      }

      .file-content {
        display: inline-block;
        position: relative;
      }

      .download:hover .fa.icon-down {
        max-height: 14px;
      }

      .download:hover .download-text {
        display: block;
      }

      .footer {
        border-top: 1px solid #ebebeb;
        background-color: #fff;
        height: 50px;
        padding: 0 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .filename {
        font-size: 16px;
        font-weight: 700;
      }

      .filesize, .filetype {
        font-size: 14px;
        color: #999;
        text-transform: uppercase;
      }

      .footer-right {
        display: flex;
      }

      .logo {
        margin-left: 10px;
        height: 20px;
      }
    </style>
  </head>

  <body>

    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MMLMP6C"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <div class="content">
      <%= render @view_module, @view_template, assigns %>
    </div>

    <%= render "_sentry.html", conn: @conn %>
    <script src="<%= static_path(@conn, "/js/landing_app.js") %>"></script>
    <link rel="stylesheet" href="<%= static_path(@conn, "/css/landing-non-critical.css") %>">
  </body>
</html>
