<%
locked = !!Stitch.Web.SessionService.get_user_session_lock_status(@conn)
user = Map.get(@conn.assigns, :current_user)
authenticationToken = user && user.token
current_user =
  case user do
    nil ->
      Poison.encode!(%{})
    user ->
      Poison.encode!(%{
        "id" => user.id,
        "whatsNewLastSeenAt" => user.whats_new_last_seen_at,
        "firstName" => user.first_name,
        "lastName" => user.last_name,
        "roles" => user.roles,
        "username" => user.username,
        "email" => user.email,
        "title" => user.title,
        "phone" => user.phone_number,
        "avatar" => Stitch.PresignedUrlCache.fetch(user.profile_image_url),
        "avatar_thumb" => Stitch.Web.Api.V1.UserView.avatar_thumb(user),
        "desktop_sound" => user.desktop_sound,
        "connect_tour_status" => user.connect_tour_status,
        "platform_tour_status" => user.platform_tour_status,
        "team" => %{
          "securityLockoutEnabled" => user.team.security_lockout,
          "secondsToLockout" => user.team.seconds_to_lockout,
          "openInvitationsEnabled" => user.team.open_invitations_enabled,
          "name" => user.team.name,
          "slug" => user.team.slug,
          "concealEnabled" => user.team.conceal_enabled,
          "id" => user.team.id,
          "engageEnabled" => Stitch.FeatureGateway.enabled?(user.team, "engage")
        }
      })
  end
%>

<script>
  window.locked = <%= locked %>;
  window.currentUser = <%= raw current_user %>;
  window.authenticationToken = "<%= authenticationToken %>";
</script>
