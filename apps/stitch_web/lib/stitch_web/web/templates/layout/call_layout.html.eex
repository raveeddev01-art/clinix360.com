<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "_tag_manager_head.html" %>
    <%= render "_shared_head.html" %>
    <title><%= if assigns[:title], do: @title, else: "Stitch" %></title>
    <meta name="description" content="<%= if assigns[:description], do: @description, else: "" %>" />
    <link rel="stylesheet" href="<%= static_path(@conn, "/css/call_app.css") %>">
    <script src="https://static.opentok.com/v2/js/opentok.min.js"></script>
    <%= render "_ie_compat.html" %>
  </head>

  <body>
    <%= render "_tag_manager_body.html" %>
    <div id="toastr" data-component="Toastr"></div>
    <%= render @view_module, @view_template, assigns %>
    <%= render "_js_variables.html", conn: @conn %>
    <%= render "_user_js_variables.html", conn: @conn %>
    <%= render "_sentry.html", conn: @conn %>
    <script src="<%= static_path(@conn, "/js/call_app.js") %>"></script>
    <%= render "_segment.html", conn: @conn %>
  </body>
</html>
