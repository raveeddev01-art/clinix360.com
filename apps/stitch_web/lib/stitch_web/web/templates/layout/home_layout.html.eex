<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "_tag_manager_head.html" %>
    <%= render "_shared_head.html" %>
    <link href="https://teamstitch.com" rel="canonical">
    <title><%= if assigns[:title], do: @title, else: "Care Coordination | Stitch" %></title>
    <meta name="description" content="<%= if assigns[:description], do: @description, else: "Stitch is care coordination platform for healthcare teams. Communicate, write notes, track tasks, upload files, and collaborate on any device." %>" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Stitch" />
    <meta property="og:title" content="<%= if assigns[:title], do: @title, else: "Care Coordination | Stitch" %>" />
    <meta property="og:description" content="<%= if assigns[:description], do: @description, else: "Stitch is care coordination platform for healthcare teams. Communicate, write notes, track tasks, upload files, and collaborate on any device." %>" />
    <meta property="og:image" content="https://pbs.twimg.com/profile_images/676215970696790017/08nKtH21_400x400.png" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@stitchhq" />
    <meta name="twitter:title" content="<%= if assigns[:title], do: @title, else: "Care Coordination | Stitch" %>" />
    <meta name="twitter:description" content="<%= if assigns[:description], do: @description, else: "Stitch is care coordination platform for healthcare teams. Communicate, write notes, track tasks, upload files, and collaborate on any device." %>" />
    <meta name="twitter:image" content="https://pbs.twimg.com/profile_images/676215970696790017/08nKtH21_400x400.png" />

    <link rel="stylesheet" href="<%= static_path(@conn, "/css/landing.css") %>">
    <%= render "_google_analytics.html", conn: @conn %>
    <%= render "_structured_data.html", conn: @conn %>
    <%= render "_ie_compat.html" %>
  </head>

  <body>
    <%= render "_tag_manager_body.html" %>
    <%= render @view_module, @view_template, assigns %>
    <%= render "_js_variables.html", conn: @conn %>
    <%= render "_user_js_variables.html", conn: @conn %>
    <%= render "_sentry.html", conn: @conn %>
    <script src="<%= static_path(@conn, "/js/landing_app.js") %>"></script>
    <%= render "_segment.html", conn: @conn %>
    <link rel="stylesheet" href="<%= static_path(@conn, "/css/landing-non-critical.css") %>">
  </body>
</html>
