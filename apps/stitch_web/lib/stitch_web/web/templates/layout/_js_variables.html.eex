<%
applicationHost = Application.fetch_env!(:stitch_web, :application_host)
applicationScheme = Application.fetch_env!(:stitch_web, :application_scheme)
websocketScheme = Application.fetch_env!(:stitch_web, :websocket_scheme)
session_id = Plug.Conn.get_session(@conn, :session_id)
public_bucket_name = Application.fetch_env!(:stitch, :public_cdn)[:bucket]
teams = Stitch.Web.PageService.get_logins(@conn)
patient_teams = Stitch.Web.PageService.get_logins(@conn, :patient_login_map)
app_settings = Poison.encode!(%{
  hasLogin: Enum.any?(teams),
  hasPatientLogin: Enum.any?(patient_teams),
  teams: teams,
  patientTeams: patient_teams,
  notification_sounds: Stitch.Accounts.User.notification_sounds(),
  cdn_origin: Application.fetch_env!(:stitch, :public_cdn)[:origin] # https://public.teamstitch.com
})
%>

<script>
  window.applicationHost = "<%= applicationHost %>";
  window.applicationScheme = "<%= applicationScheme %>";
  window.websocketScheme = "<%= websocketScheme %>";
  window.sessionId = "<%= session_id %>";
  window.applicationVersion = "<%= StitchWeb.version() %>";
  window.stripePublishableKey = "<%= Application.get_env(:stitch, :stripe_publishable_key) %>";
  window.dr_chrono_client_id = "<%= System.get_env("DRCHRONO_CLIENT_ID") %>";
  window.publicBucket = "https://s3.amazonaws.com/<%=public_bucket_name%>";
  window.appSettings = <%= raw app_settings %>
</script>
