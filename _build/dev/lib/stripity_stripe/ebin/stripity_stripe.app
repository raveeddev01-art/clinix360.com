{application,stripity_stripe,
             [{applications,[kernel,stdlib,elixir,plug,hackney,logger,jason,
                             uri_query]},
              {description,"A Stripe client for Elixir.\n"},
              {modules,['Elixir.Stripe','Elixir.Stripe.API',
                        'Elixir.Stripe.Account','Elixir.Stripe.AccountLink',
                        'Elixir.Stripe.ApplicationFee',
                        'Elixir.Stripe.Balance',
                        'Elixir.Stripe.BalanceTransaction',
                        'Elixir.Stripe.BankAccount',
                        'Elixir.Stripe.BillingPortal.Session',
                        'Elixir.Stripe.Capability','Elixir.Stripe.Card',
                        'Elixir.Stripe.Charge',
                        'Elixir.Stripe.Checkout.Session.LineItems',
                        'Elixir.Stripe.Config','Elixir.Stripe.Connect.OAuth',
                        'Elixir.Stripe.Connect.OAuth.AuthorizeResponse',
                        'Elixir.Stripe.Connect.OAuth.DeauthorizeResponse',
                        'Elixir.Stripe.Connect.OAuth.TokenResponse',
                        'Elixir.Stripe.Converter','Elixir.Stripe.CountrySpec',
                        'Elixir.Stripe.Coupon','Elixir.Stripe.CreditNote',
                        'Elixir.Stripe.CreditNoteLineItem',
                        'Elixir.Stripe.Customer',
                        'Elixir.Stripe.CustomerBalanceTransaction',
                        'Elixir.Stripe.Discount','Elixir.Stripe.Dispute',
                        'Elixir.Stripe.Entity','Elixir.Stripe.EphemeralKey',
                        'Elixir.Stripe.Error','Elixir.Stripe.Event',
                        'Elixir.Stripe.ExternalAccount',
                        'Elixir.Stripe.FeeRefund','Elixir.Stripe.FileLink',
                        'Elixir.Stripe.FileUpload','Elixir.Stripe.Invoice',
                        'Elixir.Stripe.Invoiceitem',
                        'Elixir.Stripe.Issuing.Authorization',
                        'Elixir.Stripe.Issuing.Card',
                        'Elixir.Stripe.Issuing.Cardholder',
                        'Elixir.Stripe.Issuing.Transaction',
                        'Elixir.Stripe.Issuing.Types',
                        'Elixir.Stripe.LineItem','Elixir.Stripe.List',
                        'Elixir.Stripe.LoginLink','Elixir.Stripe.Mandate',
                        'Elixir.Stripe.Order','Elixir.Stripe.OrderItem',
                        'Elixir.Stripe.OrderReturn',
                        'Elixir.Stripe.PaymentIntent',
                        'Elixir.Stripe.PaymentMethod','Elixir.Stripe.Payout',
                        'Elixir.Stripe.Person','Elixir.Stripe.Plan',
                        'Elixir.Stripe.Price','Elixir.Stripe.Product',
                        'Elixir.Stripe.PromotionCode',
                        'Elixir.Stripe.Recipient','Elixir.Stripe.Refund',
                        'Elixir.Stripe.Relay.Product','Elixir.Stripe.Request',
                        'Elixir.Stripe.Review','Elixir.Stripe.Session',
                        'Elixir.Stripe.SetupIntent','Elixir.Stripe.Sku',
                        'Elixir.Stripe.Source','Elixir.Stripe.Subscription',
                        'Elixir.Stripe.SubscriptionItem',
                        'Elixir.Stripe.SubscriptionItem.Usage',
                        'Elixir.Stripe.SubscriptionItem.UsageRecordSummary',
                        'Elixir.Stripe.SubscriptionSchedule',
                        'Elixir.Stripe.TaxID','Elixir.Stripe.TaxRate',
                        'Elixir.Stripe.Terminal.ConnectionToken',
                        'Elixir.Stripe.Terminal.Location',
                        'Elixir.Stripe.Terminal.Reader','Elixir.Stripe.Token',
                        'Elixir.Stripe.Topup','Elixir.Stripe.Transfer',
                        'Elixir.Stripe.TransferReversal',
                        'Elixir.Stripe.Types','Elixir.Stripe.URI',
                        'Elixir.Stripe.Util','Elixir.Stripe.Webhook',
                        'Elixir.Stripe.WebhookEndpoint',
                        'Elixir.Stripe.WebhookHandler',
                        'Elixir.Stripe.WebhookPlug']},
              {registered,[]},
              {vsn,"2.12.1"},
              {env,[{api_base_url,<<"https://api.stripe.com/v1/">>},
                    {api_upload_url,<<"https://files.stripe.com/v1/">>},
                    {pool_options,[{timeout,5000},{max_connections,10}]},
                    {use_connection_pool,true}]},
              {mod,{'Elixir.Stripe',[]}}]}.
